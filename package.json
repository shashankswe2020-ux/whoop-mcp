{
  "name": "whoop-ai-mcp",
  "version": "0.8.4",
  "mcpName": "io.github.shashankswe2020-ux/whoop",
  "description": "Read-only WHOOP MCP server for recovery, sleep, HRV, strain, workouts, and personal health analytics in AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "whoop-ai-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "whoop",
    "whoop-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "health",
    "fitness",
    "recovery",
    "sleep",
    "hrv",
    "workout",
    "wearable",
    "health-analytics",
    "ai",
    "claude",
    "claude-desktop",
    "codex",
    "github-copilot"
  ],
  "author": "Shashank Mishra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashankswe2020-ux/whoop-mcp.git"
  },
  "homepage": "https://shashankswe2020-ux.github.io/whoop-mcp/",
  "bugs": {
    "url": "https://github.com/shashankswe2020-ux/whoop-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.2.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vitest": "^5.0.2"
  }
}
