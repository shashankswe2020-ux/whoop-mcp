# WHOOP Developer App credentials
# Create an app at https://developer.whoop.com
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# Must match a Redirect URI registered on the app in the WHOOP dashboard,
# exactly. The local callback server listens on whatever port this names.
WHOOP_REDIRECT_URI=http://localhost:3000/callback

# Scopes to request. Must be enabled on the app in the dashboard. Note that
# `offline` is what makes WHOOP issue a refresh token: drop it and every run
# needs the browser again. Leave unset to request all of these.
# WHOOP_SCOPES=offline read:recovery read:cycles read:workout read:sleep read:profile read:body_measurement
